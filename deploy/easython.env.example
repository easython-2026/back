# Install as /etc/easython/easython.env with owner root and mode 0600.
DEMO_ENABLED=false
DB_URL="jdbc:mysql://RDS_ENDPOINT:3306/easython?sslMode=VERIFY_IDENTITY&trustCertificateKeyStoreUrl=file:/etc/easython/rds-truststore.p12&trustCertificateKeyStoreType=PKCS12&trustCertificateKeyStorePassword=changeit&serverTimezone=Asia/Seoul"
DB_USERNAME=easython
DB_PASSWORD=
DDL_AUTO=validate
JWT_SECRET=
CORS_ORIGINS=https://frontend.example.com
PUBLIC_BASE_URL=https://api.example.com
AWS_REGION=ap-northeast-2
S3_BUCKET=
AI_PROVIDER=gateway
AI_API_KEY=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
PDF_FONT_PATH=/etc/easython/NotoSansKR-Regular.ttf
