# 복사해서 .env 로 쓰거나, 환경변수로 직접 지정하세요. (.env 는 git 에 올라가지 않습니다)
# 값을 채운 .env / 실제 키는 절대 커밋하지 마세요.

# --- DB (비우면 메모리 H2) ---
DB_URL=jdbc:mysql://localhost:3306/easython?serverTimezone=Asia/Seoul
DB_USERNAME=easython
DB_PASSWORD=

# --- 보안 ---
# 32바이트 이상 임의 문자열 (예: openssl rand -base64 48)
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173

# --- AI (비우면 데모용 모의 응답) ---
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=https://dku-chat.kloud.zone/llm/v1
AI_MODEL=anthropic/claude-haiku-4.5

# --- 파일 저장 / 데모 ---
STORAGE_BACKEND=local
AWS_REGION=
S3_BUCKET=
PDF_FONT_PATH=
STORAGE_DIR=
PUBLIC_BASE_URL=
DEMO_ENABLED=true

# --- 이메일(비밀번호 재설정, Gmail SMTP 앱 비밀번호) ---
MAIL_USERNAME=
MAIL_PASSWORD=
